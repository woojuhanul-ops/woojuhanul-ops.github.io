<script>
(function(){
'use strict';
/* ============ 공통: 28개 언어 (홈페이지 NX-I18N 정본 순서) ============ */
var LANGS=[
 {c:'ko',n:'한국어',nat:'한국어',tts:'ko-KR',gt:'ko'},
 {c:'en',n:'영어',nat:'English',tts:'en-US',gt:'en'},
 {c:'zh',n:'중국어 (간체)',nat:'中文(简体)',tts:'zh-CN',gt:'zh-CN'},
 {c:'zh-TW',n:'중국어 (번체)',nat:'中文(繁體)',tts:'zh-TW',gt:'zh-TW'},
 {c:'ja',n:'일본어',nat:'日本語',tts:'ja-JP',gt:'ja'},
 {c:'es',n:'스페인어',nat:'Español',tts:'es-ES',gt:'es'},
 {c:'hi',n:'힌디어',nat:'हिन्दी',tts:'hi-IN',gt:'hi'},
 {c:'fr',n:'프랑스어',nat:'Français',tts:'fr-FR',gt:'fr'},
 {c:'de',n:'독일어',nat:'Deutsch',tts:'de-DE',gt:'de'},
 {c:'pt',n:'포르투갈어',nat:'Português',tts:'pt-PT',gt:'pt'},
 {c:'it',n:'이탈리아어',nat:'Italiano',tts:'it-IT',gt:'it'},
 {c:'ru',n:'러시아어',nat:'Русский',tts:'ru-RU',gt:'ru'},
 {c:'uk',n:'우크라이나어',nat:'Українська',tts:'uk-UA',gt:'uk'},
 {c:'ar',n:'아랍어',nat:'العربية',tts:'ar-SA',gt:'ar'},
 {c:'fa',n:'페르시아어',nat:'فارسی',tts:'fa-IR',gt:'fa'},
 {c:'th',n:'태국어',nat:'ไทย',tts:'th-TH',gt:'th'},
 {c:'vi',n:'베트남어',nat:'Tiếng Việt',tts:'vi-VN',gt:'vi'},
 {c:'id',n:'인도네시아어',nat:'Bahasa Indonesia',tts:'id-ID',gt:'id'},
 {c:'tr',n:'튀르키예어',nat:'Türkçe',tts:'tr-TR',gt:'tr'},
 {c:'nl',n:'네덜란드어',nat:'Nederlands',tts:'nl-NL',gt:'nl'},
 {c:'pl',n:'폴란드어',nat:'Polski',tts:'pl-PL',gt:'pl'},
 {c:'sv',n:'스웨덴어',nat:'Svenska',tts:'sv-SE',gt:'sv'},
 {c:'da',n:'덴마크어',nat:'Dansk',tts:'da-DK',gt:'da'},
 {c:'nb',n:'노르웨이어',nat:'Norsk',tts:'nb-NO',gt:'no'},
 {c:'fi',n:'핀란드어',nat:'Suomi',tts:'fi-FI',gt:'fi'},
 {c:'cs',n:'체코어',nat:'Čeština',tts:'cs-CZ',gt:'cs'},
 {c:'hu',n:'헝가리어',nat:'Magyar',tts:'hu-HU',gt:'hu'},
 {c:'ro',n:'루마니아어',nat:'Română',tts:'ro-RO',gt:'ro'}
];
function langBy(c){ for(var i=0;i<LANGS.length;i++) if(LANGS[i].c===c) return LANGS[i]; return LANGS[0]; }
function $(id){ return document.getElementById(id); }
function fillLangSelect(el, val){
  el.innerHTML='';
  LANGS.forEach(function(l){ var o=document.createElement('option'); o.value=l.c; o.textContent=l.n+' · '+l.nat; el.appendChild(o); });
  el.value=val;
}
/* 번역 — 홈페이지 문서 번역기와 같은 방식 (gtx 엔드포인트, 응답 조각 이어 붙이기) */
function translateText(text, slCode, tlCode){
  var sl=langBy(slCode).gt, tl=langBy(tlCode).gt;
  if(sl===tl) return Promise.resolve(text);
  var url='https://translate.googleapis.com/translate_a/single?client=gtx&sl='+encodeURIComponent(sl)+'&tl='+encodeURIComponent(tl)+'&dt=t&q='+encodeURIComponent(text);
  return fetch(url).then(function(r){ if(!r.ok) throw new Error('http '+r.status); return r.json(); }).then(function(data){
    var out='';
    if(data && Array.isArray(data[0])) data[0].forEach(function(seg){ if(seg && typeof seg[0]==='string') out+=seg[0]; });
    if(!out) throw new Error('empty');
    return out;
  });
}
/* 낭독 — 기기 TTS, 언어 태그로 음성 고르기 */
function speak(text, code, rate){
  try{
    if(!text) return;
    var l=langBy(code);
    var u=new SpeechSynthesisUtterance(text);
    u.lang=l.tts; u.rate=rate||1;
    var vs=[]; try{ vs=speechSynthesis.getVoices()||[]; }catch(e){}
    var prefs=[l.tts.split('-')[0].toLowerCase(), l.gt.toLowerCase()];
    for(var i=0;i<vs.length;i++){
      var vl=(vs[i].lang||'').replace('_','-').toLowerCase();
      if(prefs.indexOf(vl.split('-')[0])>=0){ u.voice=vs[i]; break; }
    }
    speechSynthesis.cancel();
    speechSynthesis.speak(u);
  }catch(e){}
}
function setMsg(el, text, ok){
  el.textContent=text||'';
  el.className='msg '+(text?(ok?'ok':'err'):'');
}

/* ============ 화면 전환 ============ */
var SCREENS=['home','cards','shadow','daily'];
function go(name){
  if(SCREENS.indexOf(name)<0) name='home';
  SCREENS.forEach(function(s){ $('scr-'+s).classList.toggle('on', s===name); });
  if(name!=='shadow') shadowCleanup();
  try{ history.replaceState(null,'', name==='home' ? location.pathname : '?m='+name); }catch(e){}
  window.scrollTo(0,0);
}
document.querySelectorAll('[data-go]').forEach(function(b){ b.addEventListener('click', function(){ go(b.getAttribute('data-go')); }); });
document.querySelectorAll('[data-back]').forEach(function(b){ b.addEventListener('click', function(){ go('home'); }); });

/* ============ ① 다언어 암기 카드 (SRS) ============ */
var LS_CARDS='nexusEduCardsV1';
var DAY=86400000;
var INTERVAL={1:0,2:2,3:4,4:7,5:14}; /* 홈페이지 암기 카드와 같은 상자 간격 */
var uidSeq=1;
function uid(){ return 'c'+Date.now().toString(36)+(uidSeq++).toString(36)+Math.floor(Math.random()*9999); }
function seedCards(){
  var now=Date.now();
  var pairs=[
    ['안녕하세요. 만나서 반갑습니다.','Hello. Nice to meet you.'],
    ['감사합니다. 정말 도움이 됐어요.','Thank you. That was really helpful.'],
    ['천천히 말씀해 주시겠어요?','Could you speak slowly, please?'],
    ['이것은 한국어로 뭐라고 해요?','How do you say this in Korean?'],
    ['오늘 날씨가 참 좋네요.','The weather is really nice today.'],
    ['조금씩 매일 연습하면 늘어요.','If you practice a little every day, you will improve.']
  ];
  return pairs.map(function(p){ return {id:uid(), s:p[0], sl:'ko', t:p[1], tl:'en', box:1, due:now, last:0, cre:now}; });
}
function defaultCardState(){ return {from:'ko', learn:'en', cards:seedCards()}; }
function loadCards(){
  try{
    var raw=localStorage.getItem(LS_CARDS);
    if(!raw) return defaultCardState();
    var s=JSON.parse(raw);
    if(!s || !Array.isArray(s.cards)) return defaultCardState();
    if(!s.from) s.from='ko'; if(!s.learn) s.learn='en';
    return s;
  }catch(e){ return defaultCardState(); }
}
var CS=loadCards();
function saveCards(){ try{ localStorage.setItem(LS_CARDS, JSON.stringify(CS)); }catch(e){} }
function dueCards(){ var now=Date.now(); return CS.cards.filter(function(c){ return c.due<=now; }).sort(function(a,b){ return a.due-b.due; }); }
function renderCardsStat(){
  $('cardsStat').innerHTML='카드 <b>'+CS.cards.length+'</b>장 · 오늘 복습 <b>'+dueCards().length+'</b>장';
}
function renderCardList(){
  var wrap=$('cardList'); wrap.innerHTML='';
  if(!CS.cards.length){ wrap.innerHTML='<p class="stat">아직 카드가 없습니다. 위에서 첫 문장을 넣어 보세요.</p>'; return; }
  CS.cards.slice().sort(function(a,b){ return b.cre-a.cre; }).forEach(function(c){
    var row=document.createElement('div'); row.className='cardrow';
    var when=new Date(c.due); var dueTxt=(c.due<=Date.now())?'복습할 때가 됐어요':'다음 복습 '+ (when.getMonth()+1)+'월 '+when.getDate()+'일';
    row.innerHTML='<div class="ct"><b></b><span></span></div><span class="box">'+c.box+'단계</span>';
    row.querySelector('b').textContent=c.t;
    row.querySelector('span').textContent=c.s+' · '+dueTxt;
    var del=document.createElement('button'); del.className='del'; del.textContent='✕'; del.title='카드 지우기';
    del.addEventListener('click', function(){
      CS.cards=CS.cards.filter(function(x){ return x.id!==c.id; });
      saveCards(); renderCardsStat(); renderCardList();
      setMsg($('cardMsg'),'카드를 지웠습니다.', true);
    });
    row.appendChild(del);
    wrap.appendChild(row);
  });
}
var revQueue=[], revIdx=0, revFlipped=false, revTotal=0;
function renderRev(){
  var c=revQueue[revIdx]; if(!c){ finishRev(); return; }
  revFlipped=false;
  $('revLang').textContent=langBy(c.tl).n+' · '+c.box+'단계';
  $('revText').textContent=c.t;
  $('revHint').textContent='카드를 누르면 뜻이 열립니다';
  $('revBtns').style.display='none';
  $('revProg').textContent=(revIdx+1)+' / '+revTotal;
  $('revProgBar').style.width=Math.round(revIdx/revTotal*100)+'%';
}
function startRev(all){
  var q=all? CS.cards.slice().sort(function(a,b){ return a.due-b.due; }) : dueCards();
  if(!q.length){
    setMsg($('cardMsg'), all? '아직 카드가 없습니다.' : '오늘 복습할 카드가 없습니다. 새 카드를 만들거나, 내일 다시 오세요.', !all);
    if(!all){ $('revHome').style.display='none'; $('revArea').style.display='none'; $('revDone').style.display='block'; $('revDoneMsg').textContent='오늘 복습할 카드가 없습니다. 잠그는 것 없이, 내일 또 열립니다.'; $('btnRevAgain').style.display=CS.cards.length?'':'none'; }
    return;
  }
  revQueue=q; revIdx=0; revTotal=q.length;
  $('revHome').style.display='none'; $('revDone').style.display='none'; $('revArea').style.display='block';
  renderRev();
}
function finishRev(){
  $('revArea').style.display='none'; $('revDone').style.display='block';
  $('revDoneMsg').textContent='복습 '+revTotal+'장을 마쳤습니다. 맞힌 카드는 며칠 뒤에, 틀린 카드는 오늘 다시 찾아옵니다.';
  $('btnRevAgain').style.display=CS.cards.length?'':'none';
  $('revProgBar').style.width='100%';
  renderCardsStat(); renderCardList();
}
function gradeCurrent(know){
  var c=revQueue[revIdx]; if(!c) return;
  var sod=new Date(); sod.setHours(0,0,0,0);
  if(know){ c.box=Math.min(5, c.box+1); c.due=sod.getTime()+INTERVAL[c.box]*DAY; }
  else { c.box=1; c.due=Date.now(); }
  c.last=Date.now();
  saveCards();
  revIdx++;
  if(revIdx>=revQueue.length) finishRev(); else renderRev();
}
function initCards(){
  fillLangSelect($('fromLang'), CS.from);
  fillLangSelect($('learnLang'), CS.learn);
  $('fromLang').addEventListener('change', function(){ CS.from=this.value; saveCards(); });
  $('learnLang').addEventListener('change', function(){ CS.learn=this.value; saveCards(); });
  $('btnSwap').addEventListener('click', function(){
    var a=CS.from; CS.from=CS.learn; CS.learn=a;
    $('fromLang').value=CS.from; $('learnLang').value=CS.learn; saveCards();
  });
  $('btnMakeCard').addEventListener('click', function(){
    var text=$('addText').value.trim();
    if(!text){ setMsg($('cardMsg'),'외울 문장이나 단어를 먼저 적어 주세요.', false); return; }
    setMsg($('cardMsg'),'번역하는 중입니다…', true);
    translateText(text, CS.from, CS.learn).then(function(out){
      $('addTgt').value=out;
      $('addPreview').style.display='block';
      setMsg($('cardMsg'),'번역이 됐습니다. 다듬고 저장해 보세요.', true);
    }).catch(function(){
      setMsg($('cardMsg'),'번역에 닿지 않았습니다. 연결을 확인하고 다시 시도해 주세요.', false);
    });
  });
  $('btnSaveCard').addEventListener('click', function(){
    var s=$('addText').value.trim(), t=$('addTgt').value.trim();
    if(!s || !t){ setMsg($('cardMsg'),'원문과 번역이 둘 다 있어야 카드가 됩니다.', false); return; }
    CS.cards.push({id:uid(), s:s, sl:CS.from, t:t, tl:CS.learn, box:1, due:Date.now(), last:0, cre:Date.now()});
    saveCards();
    $('addText').value=''; $('addTgt').value=''; $('addPreview').style.display='none';
    setMsg($('cardMsg'),'카드를 저장했습니다. 오늘 복습에 바로 들어갑니다.', true);
    renderCardsStat(); renderCardList();
  });
  $('btnHearPair').addEventListener('click', function(){
    speak($('addText').value.trim(), CS.from, 0.95);
    var t=$('addTgt').value.trim(), l=CS.learn;
    setTimeout(function(){ speak(t, l, 0.95); }, 1100);
  });
  $('btnReview').addEventListener('click', function(){ startRev(false); });
  $('btnRevAgain').addEventListener('click', function(){ $('revDone').style.display='none'; $('revHome').style.display='block'; startRev(true); });
  $('revCard').addEventListener('click', function(e){
    if(e.target && e.target.id==='btnRevSpeak') return;
    var c=revQueue[revIdx]; if(!c || revFlipped) return;
    revFlipped=true;
    $('revLang').textContent=langBy(c.sl).n+' (뜻)';
    $('revText').textContent=c.s;
    $('revHint').textContent='뜻을 확인했습니다. 얼마나 알았는지 골라 주세요';
    $('revBtns').style.display='flex';
  });
  $('btnRevSpeak').addEventListener('click', function(e){
    e.stopPropagation();
    var c=revQueue[revIdx]; if(!c) return;
    speak(revFlipped? c.s : c.t, revFlipped? c.sl : c.tl, 0.9);
  });
  $('btnKnow').addEventListener('click', function(){ gradeCurrent(true); });
  $('btnDont').addEventListener('click', function(){ gradeCurrent(false); });
  $('btnWipe').addEventListener('click', function(){
    if(!CS.cards.length) return;
    if(!window.confirm('카드 '+CS.cards.length+'장을 전부 지울까요? 지운 카드는 돌아오지 않습니다.')) return;
    CS.cards=[]; saveCards(); renderCardsStat(); renderCardList();
    setMsg($('cardMsg'),'카드를 전부 지웠습니다.', true);
  });
  saveCards();
  renderCardsStat(); renderCardList();
}

/* ============ ② 듣고 따라 말하기 (쉐도잉) ============ */
var mediaRec=null, recChunks=[], recStream=null, recUrl=null;
var recCount=0;
try{ recCount=parseInt(localStorage.getItem('nexusEduShadowCount')||'0',10)||0; }catch(e){}
function renderRecCount(){ $('recCount').textContent=recCount? '지금까지 '+recCount+'번 따라 말했습니다. 기록은 이 기기에만 남습니다.' : ''; }
function splitSentences(text){
  var flat=(text||'').replace(/\s+/g,' ').trim();
  if(!flat) return [];
  var parts=flat.match(/[^.!?…。！？]+[.!?…。！？]*/g);
  if(!parts) return [flat];
  return parts.map(function(s){ return s.trim(); }).filter(Boolean);
}
function renderSentences(){
  var list=splitSentences($('shText').value);
  var wrap=$('shSentences'); wrap.innerHTML='';
  list.forEach(function(s){
    var row=document.createElement('div'); row.className='sentrow';
    var span=document.createElement('span'); span.className='st'; span.textContent=s;
    var btn=document.createElement('button'); btn.textContent='🔊'; btn.title='이 문장 듣기';
    btn.addEventListener('click', function(){ speak(s, $('shLang').value, parseFloat($('shRate').value)); });
    row.appendChild(span); row.appendChild(btn);
    wrap.appendChild(row);
  });
  if(list.length) setMsg($('shMsg'), list.length+'문장으로 나눴습니다. 문장마다 듣고 따라 말해 보세요.', true);
}
function shadowCleanup(){
  if(mediaRec && mediaRec.state==='recording'){ try{ mediaRec.stop(); }catch(e){} }
  if(recStream){ recStream.getTracks().forEach(function(t){ t.stop(); }); recStream=null; }
  if(recUrl){ URL.revokeObjectURL(recUrl); recUrl=null; }
  var w=$('myAudioWrap'); if(w) w.style.display='none';
  var b=$('btnRec'); if(b) b.classList.remove('rec');
  var l=$('recLabel'); if(l) l.textContent='녹음 시작';
}
function initShadow(){
  fillLangSelect($('shLang'), 'en');
  fillLangSelect($('shMyLang'), 'ko');
  renderRecCount();
  $('btnShPlayAll').addEventListener('click', function(){
    var t=$('shText').value.trim();
    if(!t){ setMsg($('shMsg'),'연습할 문장을 먼저 적어 주세요.', false); return; }
    speak(t, $('shLang').value, parseFloat($('shRate').value));
  });
  $('btnShSplit').addEventListener('click', renderSentences);
  $('shText').addEventListener('change', renderSentences);
  $('btnShMean').addEventListener('click', function(){
    var t=$('shText').value.trim();
    if(!t){ setMsg($('shMsg'),'뜻을 볼 문장을 먼저 적어 주세요.', false); return; }
    setMsg($('shMsg'),'뜻을 가져오는 중입니다…', true);
    translateText(t, $('shLang').value, $('shMyLang').value).then(function(out){
      var m=$('shMeaning'); m.style.display='block';
      m.innerHTML='<b>뜻 ('+langBy($('shMyLang').value).n+')</b>';
      m.appendChild(document.createTextNode(out));
      setMsg($('shMsg'),'뜻을 열었습니다.', true);
    }).catch(function(){ setMsg($('shMsg'),'번역에 닿지 않았습니다. 다시 시도해 주세요.', false); });
  });
  $('btnHearOrig').addEventListener('click', function(){
    speak($('shText').value.trim(), $('shLang').value, parseFloat($('shRate').value));
  });
  $('btnRec').addEventListener('click', function(){
    if(mediaRec && mediaRec.state==='recording'){ mediaRec.stop(); return; }
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || !window.MediaRecorder){
      setMsg($('shMsg'),'이 기기에서는 녹음을 쓸 수 없습니다. 듣기 연습만 이용해 주세요.', false); return;
    }
    navigator.mediaDevices.getUserMedia({audio:true}).then(function(stream){
      recStream=stream; recChunks=[];
      mediaRec=new MediaRecorder(stream);
      mediaRec.ondataavailable=function(e){ if(e.data && e.data.size) recChunks.push(e.data); };
      mediaRec.onstop=function(){
        if(recStream){ recStream.getTracks().forEach(function(t){ t.stop(); }); recStream=null; }
        $('btnRec').classList.remove('rec'); $('recLabel').textContent='녹음 시작';
        if(!recChunks.length) return;
        if(recUrl) URL.revokeObjectURL(recUrl);
        var blob=new Blob(recChunks, {type: mediaRec.mimeType || 'audio/webm'});
        recUrl=URL.createObjectURL(blob);
        $('myAudio').src=recUrl;
        $('myAudioWrap').style.display='block';
        recCount++;
        try{ localStorage.setItem('nexusEduShadowCount', String(recCount)); }catch(e){}
        renderRecCount();
        setMsg($('shMsg'),'녹음이 됐습니다. 원음과 번갈아 들어 보세요.', true);
      };
      mediaRec.start();
      $('btnRec').classList.add('rec'); $('recLabel').textContent='녹음 중 — 누르면 멈춤';
      setMsg($('shMsg'),'듣고 있습니다. 문장을 따라 말해 보세요.', true);
    }).catch(function(){
      setMsg($('shMsg'),'마이크 권한이 없어 녹음할 수 없습니다.', false);
    });
  });
}

