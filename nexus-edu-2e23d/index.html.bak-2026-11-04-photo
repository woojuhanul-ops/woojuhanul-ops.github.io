<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>넥서스 교육 — Nexus Education</title>
<meta name="description" content="28개 언어로 배우는 학습 디렉토리 — 다언어 암기 카드, 듣고 따라 말하기, 오늘의 한 문장. 전부 무료, 광고·구독·학습량 제한 없음">
<link rel="manifest" href="/manifest.json">
<link rel="icon" href="/icon-192.png">
<meta property="og:title" content="넥서스 교육">
<meta property="og:description" content="내 언어로, 원하는 언어를. 28개 언어 학습 디렉토리입니다">
<meta property="og:image" content="/icon-512.png">
<style>
  :root{--bg:#0B1226;--cyan:#38BDF8;--teal:#2DD4BF;--violet:#818CF8;--ink:#F8FAFC;--muted:#A9B8D0;--card:rgba(255,255,255,.07);--line:rgba(255,255,255,.16);--yel:#FBBF24;--grn:#4ADE80;--pnk:#F472B6;--red:#F87171}
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans KR",sans-serif;font-size:17px;line-height:1.55;touch-action:manipulation;overflow-x:hidden}
  body::before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(560px 380px at 12% -60px,rgba(56,189,248,.20),transparent 70%),radial-gradient(620px 420px at 92% 108%,rgba(129,140,248,.18),transparent 70%),radial-gradient(420px 300px at 88% -40px,rgba(45,212,191,.12),transparent 70%)}
  @keyframes nxspin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
  .nxspin{transform-origin:50% 50%;animation:nxspin 26s linear infinite}
  header{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:10px 16px;background:rgba(11,15,25,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  header .logo{width:40px;height:40px;flex:none;border-radius:10px}
  header .brand{line-height:1.2;flex:1;min-width:0}
  header .brand b{font-size:15px;letter-spacing:.1em}
  header .brand span{display:block;font-size:11px;color:var(--muted);letter-spacing:.18em}
  .homebtn{flex:none;font-size:14px;font-weight:700;color:#06121f;background:linear-gradient(135deg,var(--cyan),var(--violet));border-radius:999px;padding:10px 16px;text-decoration:none;white-space:nowrap}
  main{max-width:920px;margin:0 auto;padding:20px 16px 90px;position:relative}
  .screen{display:none}
  .screen.on{display:block;animation:scrIn .35s ease both}
  @keyframes scrIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  h1{font-size:28px;margin:8px 0 6px;line-height:1.3}
  .sub{color:var(--muted);font-size:16px;margin:0 0 16px}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:20px;margin-bottom:16px}
  .notices{list-style:none;margin:6px 0 0;padding:0}
  .notices li{display:flex;gap:10px;align-items:flex-start;margin:8px 0;font-size:15.5px}
  .notices .ck{flex:none;width:24px;height:24px;border-radius:50%;background:rgba(74,222,128,.18);border:1.5px solid var(--grn);color:var(--grn);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;margin-top:1px}
  .modgrid{display:grid;gap:14px;margin-bottom:18px}
  @media(min-width:640px){.modgrid{grid-template-columns:1fr 1fr 1fr}}
  .modcard{display:flex;flex-direction:column;align-items:flex-start;gap:8px;text-align:left;background:var(--card);border:1.5px solid var(--line);border-radius:26px;padding:22px 18px;cursor:pointer;color:var(--ink);width:100%;font-family:inherit}
  .modcard:active{transform:scale(.98)}
  .modcard .mic-ic{width:76px;height:76px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);border:1.5px solid var(--line);font-size:36px}
  .modcard b{font-size:21px}
  .modcard span{color:var(--muted);font-size:14.5px;line-height:1.45}
  .modcard .tag{align-self:flex-start;font-size:12px;font-weight:800;letter-spacing:.08em;color:#0B1226;background:linear-gradient(135deg,var(--teal),var(--cyan));border-radius:999px;padding:3px 10px}
  .dirmap{display:grid;gap:10px}
  .dirrow{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:18px;padding:14px 16px}
  .dirrow .dn{font-size:19px}
  .dirrow b{font-size:16.5px}
  .dirrow span{color:var(--muted);font-size:13.5px;display:block}
  .dirrow .st{margin-left:auto;flex:none;font-size:12.5px;font-weight:800;border-radius:999px;padding:4px 11px;border:1px solid var(--line);color:var(--muted)}
  .dirrow .st.open{color:#06251d;background:linear-gradient(135deg,var(--grn),var(--teal));border:0}
  .backbtn{display:inline-flex;align-items:center;gap:8px;min-height:50px;padding:8px 18px;font-size:16px;font-weight:700;border-radius:999px;border:1.5px solid var(--line);background:rgba(255,255,255,.07);color:var(--ink);cursor:pointer;font-family:inherit}
  .playhead{display:flex;align-items:center;gap:12px;margin-bottom:12px}
  .playhead h1{flex:1;margin:0;font-size:24px}
  .bigbtn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:64px;font-size:19px;font-weight:800;border-radius:20px;border:0;cursor:pointer;color:#0B1226;font-family:inherit;background:linear-gradient(135deg,var(--teal),var(--cyan));padding:12px 16px}
  .bigbtn:active{transform:scale(.98)}
  .bigbtn.alt{background:linear-gradient(135deg,var(--yel),#FB923C)}
  .bigbtn.vio{background:linear-gradient(135deg,var(--violet),var(--pnk));color:#fff}
  .bigbtn.ghost{background:rgba(255,255,255,.08);color:var(--ink);border:1.5px solid var(--line)}
  .bigbtn:disabled{opacity:.45;cursor:default;transform:none}
  .btnrow{display:flex;gap:10px;flex-wrap:wrap}
  .btnrow .bigbtn{flex:1;min-width:140px}
  label.flabel{display:block;font-size:14px;font-weight:700;color:var(--muted);margin:14px 0 6px}
  select.input,textarea.input,input.input{width:100%;background:rgba(255,255,255,.06);border:1.5px solid var(--line);border-radius:16px;color:var(--ink);font-size:17px;padding:13px 14px;font-family:inherit}
  select.input option{background:#131E3A;color:var(--ink)}
  textarea.input{min-height:96px;resize:vertical;line-height:1.5}
  .selrow{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:end}
  .selrow .swap{align-self:center;width:44px;height:44px;border-radius:50%;border:1.5px solid var(--line);background:rgba(255,255,255,.07);color:var(--ink);font-size:19px;cursor:pointer}
  .stat{font-size:15px;color:var(--muted);margin:10px 0}
  .stat b{color:var(--ink)}
  .msg{font-size:15.5px;min-height:24px;margin:10px 0;font-weight:600}
  .msg.err{color:var(--red)}
  .msg.ok{color:var(--grn)}
  /* 복습 카드 */
  .revstage{perspective:900px;margin:6px 0 14px}
  .revcard{position:relative;min-height:230px;border-radius:26px;border:1.5px solid var(--line);background:linear-gradient(160deg,rgba(56,189,248,.12),rgba(129,140,248,.10)),rgba(255,255,255,.05);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:26px 20px;text-align:center;cursor:pointer}
  .revcard .rlang{position:absolute;top:14px;left:18px;font-size:12.5px;font-weight:800;letter-spacing:.08em;color:var(--cyan)}
  .revcard .rtext{font-size:27px;font-weight:800;line-height:1.45;word-break:keep-all;overflow-wrap:anywhere}
  .revcard .rsub{color:var(--muted);font-size:15px}
  .revcard .spk{position:absolute;top:10px;right:12px;width:48px;height:48px;border-radius:50%;border:1.5px solid var(--line);background:rgba(255,255,255,.09);color:var(--ink);font-size:21px;cursor:pointer}
  .prog{height:10px;border-radius:99px;background:rgba(255,255,255,.10);overflow:hidden;margin:8px 0 14px}
  .prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--teal),var(--cyan));border-radius:99px;transition:width .3s ease}
  .cardrow{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:16px;padding:12px 14px;margin-bottom:8px}
  .cardrow .ct{flex:1;min-width:0}
  .cardrow .ct b{display:block;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cardrow .ct span{color:var(--muted);font-size:13.5px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cardrow .box{flex:none;font-size:12px;font-weight:800;color:var(--yel);border:1px solid rgba(251,191,36,.5);border-radius:999px;padding:3px 9px}
  .cardrow .del{flex:none;width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--red);font-size:16px;cursor:pointer}
  /* 쉐도잉 */
  .sentlist{display:grid;gap:8px;margin-top:12px}
  .sentrow{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:16px;padding:12px 14px}
  .sentrow .st{flex:1;font-size:17px;line-height:1.5}
  .sentrow button{flex:none;width:46px;height:46px;border-radius:50%;border:1.5px solid var(--line);background:rgba(255,255,255,.08);color:var(--ink);font-size:19px;cursor:pointer}
  .recbtn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:68px;font-size:19px;font-weight:800;border-radius:20px;border:1.5px solid var(--line);background:rgba(255,255,255,.07);color:var(--ink);cursor:pointer;font-family:inherit}
  .recbtn .dot{width:15px;height:15px;border-radius:50%;background:var(--red)}
  .recbtn.rec{border-color:var(--red);background:rgba(248,113,113,.12)}
  .recbtn.rec .dot{animation:blink 1s ease-in-out infinite}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
  audio{width:100%;margin-top:10px}
  .micnote{color:var(--muted);font-size:13.5px;margin-top:8px;line-height:1.5}
  /* 오늘의 한 문장 */
  .dailydate{font-size:14px;font-weight:800;letter-spacing:.1em;color:var(--cyan);margin-bottom:6px}
  .dailytext{font-size:29px;font-weight:800;line-height:1.5;word-break:keep-all;overflow-wrap:anywhere;margin:6px 0 10px}
  .dailyorig{color:var(--muted);font-size:16.5px;line-height:1.55;border-top:1px dashed var(--line);padding-top:12px;margin-top:6px}
  .dailyorig b{color:var(--ink);font-size:13px;letter-spacing:.08em;display:block;margin-bottom:4px}
  .navrow{display:flex;gap:10px;margin-top:14px}
  .navrow .bigbtn{flex:1;min-height:54px;font-size:16px}
  .foot{color:var(--muted);font-size:13px;text-align:center;margin-top:26px;line-height:1.6}
</style>
<style id="nx-pagefix">html,body{overflow-x:clip}body>header{flex-wrap:wrap}header .brandlink{min-width:0}header .brand{min-width:0;overflow:hidden}header .brand b{white-space:nowrap}header .brand span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.nx-langwrap{flex:none!important}</style></head>
<body>
<header>
  <img class="logo nxspin" src="/icon-192.png" alt="">
  <div class="brand"><b>넥서스 교육</b><span>NEXUS EDUCATION</span></div>
  </header>
<main>

  <!-- ===== 홈 (디렉토리) ===== -->
  <section class="screen" id="scr-home">
    <h1>내 언어로, 원하는 언어를</h1>
    <p class="sub">넥서스 교육은 28개 언어 학습 디렉토리입니다. 소스 언어와 출력 언어가 무엇이든, 모든 쌍으로 바꿔 배우는 방부터 엽니다.</p>
    <div class="modgrid">
      <button class="modcard" data-go="cards">
        <span class="tag">언어 · 핵심 엔진</span>
        <span class="mic-ic">🃏</span>
        <b>다언어 암기 카드</b>
        <span>문장을 넣으면 28개 언어 어느 쌍으로든 카드가 됩니다. 망각 곡선 복습이 잊기 직전에 다시 꺼내 줍니다.</span>
      </button>
      <button class="modcard" data-go="shadow">
        <span class="tag">언어 · 말하기</span>
        <span class="mic-ic">🎧</span>
        <b>듣고 따라 말하기</b>
        <span>내 문장·내 자막을 원하는 언어로 듣고, 속도를 조절해 따라 말하는 쉐도잉 연습입니다.</span>
      </button>
      <button class="modcard" data-go="daily">
        <span class="tag">언어 · 매일</span>
        <span class="mic-ic">🌅</span>
        <b>오늘의 한 문장</b>
        <span>날짜마다 한 문장. 28개 언어로 바꿔 보고, 듣고, 따라 말하는 아침의 의식입니다.</span>
      </button>
    </div>
    <div class="panel">
      <b style="font-size:17px">이 디렉토리의 약속</b>
      <ul class="notices">
        <li><span class="ck">✓</span><span>전부 무료입니다. 광고도, 구독도 없습니다.</span></li>
        <li><span class="ck">✓</span><span>학습량을 잠그는 장치가 없습니다. 하트·에너지·횟수 제한 없이 원하는 만큼 배웁니다.</span></li>
        <li><span class="ck">✓</span><span>학습 기록은 이 기기 안에만 남습니다. 서버로 보내지 않습니다.</span></li>
        <li><span class="ck">✓</span><span>번역은 문장을 번역 엔진으로 보냅니다. 카드와 기록은 기기 밖으로 나가지 않습니다.</span></li>
      </ul>
    </div>
    <div class="panel">
      <b style="font-size:17px">디렉토리 지도</b>
      <p class="sub" style="margin:6px 0 12px">연령과 분야의 방을 하나씩 엽니다. 열린 방부터 안내합니다.</p>
      <div class="dirmap">
        <div class="dirrow"><span class="dn">🗣️</span><div><b>언어</b><span>암기 카드 · 쉐도잉 · 오늘의 한 문장</span></div><span class="st open">열림</span></div>
        <div class="dirrow"><span class="dn">🧮</span><div><b>수학·교과</b><span>함께 풀기 방을 설계 중입니다</span></div><span class="st">준비 중</span></div>
        <div class="dirrow"><span class="dn">📜</span><div><b>자격·시험</b><span>기출·암기 방을 설계 중입니다</span></div><span class="st">준비 중</span></div>
        <div class="dirrow"><span class="dn">🏠</span><div><b>생활 학습</b><span>내 문서로 배우는 방을 설계 중입니다</span></div><span class="st">준비 중</span></div>
      </div>
    </div>
    <p class="foot">넥서스 교육 — 넥서스 그룹의 세 번째 디렉토리 (툴즈 · 게임즈 · 교육)</p>
  </section>

  <!-- ===== ① 다언어 암기 카드 ===== -->
  <section class="screen" id="scr-cards">
    <div class="playhead">
      <button class="backbtn" data-back>← 디렉토리</button>
      <h1>다언어 암기 카드</h1>
    </div>
    <p class="sub">문장이나 단어를 넣으면 원하는 언어 쌍으로 카드가 됩니다. 복습은 망각 곡선이 정한 날에 다시 찾아옵니다. 횟수 제한은 없습니다.</p>
  <!-- NX-BOUNDARY-2026-11-04 --><p class="sub nx-boundary" style="border:1px solid rgba(255,255,255,.18);border-radius:10px;padding:8px 10px">역할 안내: 이 카드는 <b>언어 학습 전용</b>입니다 — 문장이 번역되어 카드가 됩니다. 과목 제한 없이 무엇이든 외우는 카드는 <a href="https://nexus-flash-cards.web.app">암기 카드(102)</a>에 있습니다.</p>

    <div class="panel">
      <div class="selrow">
        <div><label class="flabel" for="fromLang" style="margin-top:0">내 언어 (원문)</label><select class="input" id="fromLang"></select></div>
        <button class="swap" id="btnSwap" title="언어 바꾸기">⇄</button>
        <div><label class="flabel" for="learnLang" style="margin-top:0">배우는 언어</label><select class="input" id="learnLang"></select></div>
      </div>
      <label class="flabel" for="addText">외울 문장·단어</label>
      <textarea class="input" id="addText" placeholder="예: 천천히 말씀해 주시겠어요?"></textarea>
      <div class="btnrow" style="margin-top:12px">
        <button class="bigbtn" id="btnMakeCard">번역해 카드 미리보기</button>
      </div>
      <div id="addPreview" style="display:none">
        <label class="flabel" for="addTgt">번역 결과 (다듬어도 됩니다)</label>
        <textarea class="input" id="addTgt"></textarea>
        <div class="btnrow" style="margin-top:12px">
          <button class="bigbtn alt" id="btnSaveCard">이 카드 저장</button>
          <button class="bigbtn ghost" id="btnHearPair">🔊 양쪽 다 듣기</button>
        </div>
      </div>
      <p class="msg" id="cardMsg"></p>
    </div>

    <div class="panel">
      <b style="font-size:17px">오늘의 복습</b>
      <p class="stat" id="cardsStat">카드 <b>0</b>장 · 오늘 복습 <b>0</b>장</p>
      <div id="revHome">
        <button class="bigbtn vio" id="btnReview">복습 시작</button>
      </div>
      <div id="revArea" style="display:none">
        <div class="prog"><i id="revProgBar"></i></div>
        <p class="stat" id="revProg" style="margin:0 0 8px">0 / 0</p>
        <div class="revstage">
          <div class="revcard" id="revCard">
            <span class="rlang" id="revLang"></span>
            <button class="spk" id="btnRevSpeak" title="듣기">🔊</button>
            <div class="rtext" id="revText"></div>
            <div class="rsub" id="revHint">카드를 누르면 뜻이 열립니다</div>
          </div>
        </div>
        <div class="btnrow" id="revBtns" style="display:none">
          <button class="bigbtn ghost" id="btnDont">몰라요</button>
          <button class="bigbtn" id="btnKnow">알아요</button>
        </div>
      </div>
      <div id="revDone" style="display:none">
        <p class="msg ok" id="revDoneMsg">오늘 복습을 마쳤습니다.</p>
        <button class="bigbtn ghost" id="btnRevAgain">남은 카드 더 보기</button>
      </div>
    </div>

    <div class="panel">
      <b style="font-size:17px">내 카드</b>
      <div id="cardList" style="margin-top:12px"></div>
      <button class="bigbtn ghost" id="btnWipe" style="margin-top:8px;min-height:50px;font-size:15px">카드 전부 지우기</button>
    </div>
  </section>

  <!-- ===== ② 듣고 따라 말하기 (쉐도잉) ===== -->
  <section class="screen" id="scr-shadow">
    <div class="playhead">
      <button class="backbtn" data-back>← 디렉토리</button>
      <h1>듣고 따라 말하기</h1>
    </div>
    <p class="sub">내 문장, 내 자막을 원하는 언어로 듣고 따라 말합니다. 재료가 내 것이니, 어떤 언어의 문장이든 연습이 됩니다.</p>

    <div class="panel">
      <label class="flabel" for="shText" style="margin-top:0">연습할 문장·자막</label>
      <textarea class="input" id="shText" style="min-height:120px" placeholder="따라 말하고 싶은 문장을 붙여 넣거나 적어 보세요."></textarea>
      <div class="selrow" style="grid-template-columns:1fr 1fr">
        <div><label class="flabel" for="shLang">문장의 언어</label><select class="input" id="shLang"></select></div>
        <div><label class="flabel" for="shRate">듣는 속도</label>
          <select class="input" id="shRate">
            <option value="0.6">아주 천천히</option>
