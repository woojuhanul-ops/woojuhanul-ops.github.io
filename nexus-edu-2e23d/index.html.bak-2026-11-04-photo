var dailyOffset=0, dailyCache={}, dailyCur={text:'', lang:'ko', orig:''};
function dailyDate(offset){
  var d=new Date(); d.setHours(0,0,0,0); d.setDate(d.getDate()+offset); return d;
}
function dailyItem(offset){
  var d=dailyDate(offset);
  var days=Math.floor(d.getTime()/DAY);
  var idx=((days % BANK.length)+BANK.length)%BANK.length;
  return {item:BANK[idx], date:d};
}
function renderDaily(){
  var got=dailyItem(dailyOffset), item=got.item, d=got.date;
  var label=d.toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric',weekday:'long'});
  var when=dailyOffset===0?'오늘의 문장':(dailyOffset===-1?'어제의 문장':(dailyOffset===1?'내일의 문장':'문장'));
  $('dailyDate').textContent=label+' · '+when+' · '+item.th;
  $('dailyOrig').textContent=item.ko;
  dailyCur.orig=item.ko;
  $('btnDailyToday').style.display=dailyOffset===0?'none':'';
  var target=$('dailyLang').value;
  $('dailyOrigWrap').style.display=(target==='ko')?'none':'block';
  var key=dailyOffset+'|'+target;
  if(target==='ko'){ dailyCur={text:item.ko, lang:'ko', orig:item.ko}; $('dailyText').textContent=item.ko; setMsg($('dailyMsg'),'', true); return; }
  if(dailyCache[key]){ dailyCur={text:dailyCache[key], lang:target, orig:item.ko}; $('dailyText').textContent=dailyCache[key]; setMsg($('dailyMsg'),'', true); return; }
  $('dailyText').textContent='문장을 바꾸는 중입니다…';
  translateText(item.ko, 'ko', target).then(function(out){
    dailyCache[key]=out;
    if(dailyOffset===0 || dailyItem(dailyOffset).item===item){
      dailyCur={text:out, lang:target, orig:item.ko};
      $('dailyText').textContent=out;
      setMsg($('dailyMsg'),'', true);
    }
  }).catch(function(){
    dailyCur={text:item.ko, lang:'ko', orig:item.ko};
    $('dailyText').textContent=item.ko;
    setMsg($('dailyMsg'),'번역에 닿지 않아 원문(한국어)을 보여 드립니다.', false);
  });
}
function initDaily(){
  var saved='en';
  try{ saved=localStorage.getItem('nexusEduDailyLang')||'en'; }catch(e){}
  if(!langBy(saved) || !saved) saved='en';
  fillLangSelect($('dailyLang'), saved);
  $('dailyLang').addEventListener('change', function(){
    try{ localStorage.setItem('nexusEduDailyLang', this.value); }catch(e){}
    renderDaily();
  });
  $('btnDailySpeak').addEventListener('click', function(){
    if(dailyCur.text) speak(dailyCur.text, dailyCur.lang, parseFloat($('dailyRate').value));
  });
  $('btnDailyPrev').addEventListener('click', function(){ dailyOffset--; renderDaily(); });
  $('btnDailyNext').addEventListener('click', function(){ dailyOffset++; renderDaily(); });
  $('btnDailyToday').addEventListener('click', function(){ dailyOffset=0; renderDaily(); });
  $('btnDailyShadow').addEventListener('click', function(){
    if(!dailyCur.text) return;
    $('shText').value=dailyCur.text;
    $('shLang').value=dailyCur.lang;
    renderSentences();
    go('shadow');
  });
  renderDaily();
}

