<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>넥서스 가계부 — Nexus Budget</title>
<meta name="description" content="수입과 지출을 이 전화기에 기록하는 가계부입니다. 모든 기록은 기기 안에서만 저장됩니다.">
<link rel="manifest" href="/manifest.json">
<link rel="icon" href="/icon-192.png">
<meta name="theme-color" content="#0B1226">
<meta property="og:title" content="넥서스 가계부 — Nexus Budget">
<meta property="og:description" content="수입과 지출을 이 전화기에 기록하는 가계부입니다. 모든 기록은 기기 안에서만 저장됩니다.">
<style>
:root{--bg:#0B1226;--cyan:#38BDF8;--teal:#2DD4BF;--violet:#818CF8;--ink:#F8FAFC;--muted:#94A3B8;--card:rgba(255,255,255,.06);--line:rgba(255,255,255,.14)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans KR",sans-serif;font-size:18px;line-height:1.6}
@keyframes nxspin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
.nxspin{transform-origin:50% 50%;animation:nxspin 26s linear infinite}
header{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:12px;padding:10px 16px;background:rgba(11,15,25,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);flex-wrap:wrap}
header .logo{width:40px;height:40px;flex:none}
header .brand{line-height:1.2;flex:1;min-width:120px}
header .brand b{font-size:15px;letter-spacing:.14em;white-space:nowrap}
header .brand span{display:block;font-size:11px;color:var(--muted);letter-spacing:.2em;white-space:nowrap}
header .brandlink{display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none;flex:none}
.testbadge{flex:none;font-size:12px;font-weight:700;color:#FDE68A;border:1px solid rgba(253,230,138,.5);border-radius:999px;padding:5px 10px}
main{max-width:720px;margin:0 auto;padding:20px 16px 48px}
h1{font-size:26px;margin:8px 0 4px}
h2{font-size:19px;margin:0 0 12px}
.sub{color:var(--muted);margin:0 0 6px}
.notice{background:rgba(45,212,191,.08);border:1px solid rgba(45,212,191,.35);border-radius:14px;padding:12px 14px;font-size:15px;margin:14px 0}
.panel{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;margin:16px 0}
label{display:block;font-size:14px;color:var(--muted);margin:0 0 6px}
input,select,textarea{width:100%;background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:12px;color:var(--ink);font-size:17px;padding:12px}
input[type=checkbox]{width:26px;height:26px;accent-color:#2DD4BF}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fields .wide{grid-column:1/-1}
.seg{display:flex;gap:8px;margin:0 0 12px}
.seg button{flex:1;padding:13px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--ink);font-size:16px;font-weight:700;cursor:pointer}
.seg button.on{background:linear-gradient(135deg,var(--teal),var(--violet));color:#06121f;border-color:transparent}
.bigbtn{display:block;width:100%;padding:17px;border:none;border-radius:16px;background:linear-gradient(135deg,var(--cyan),var(--violet));color:#06121f;font-size:19px;font-weight:800;cursor:pointer;margin-top:14px}
.bigbtn:active{transform:scale(.98)}
.ghostbtn{padding:11px 14px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--ink);font-size:15px;cursor:pointer}
.rowbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.msg{font-size:14px;color:var(--teal);min-height:22px}
.sumgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.sumbox{background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:14px;padding:12px;text-align:center}
.sumbox .k{font-size:13px;color:var(--muted)}
.sumbox .v{font-size:20px;font-weight:800}
ul.list{list-style:none;margin:0;padding:0}
ul.list li{display:flex;align-items:center;gap:10px;padding:12px 4px;border-bottom:1px solid var(--line)}
ul.list .grow{flex:1;min-width:0}
ul.list .meta{font-size:13px;color:var(--muted)}
.del{flex:none;border:1px solid var(--line);background:none;color:#FCA5A5;border-radius:10px;padding:7px 11px;cursor:pointer;font-size:14px}
.done .nm{text-decoration:line-through;color:var(--muted)}
footer{color:var(--muted);font-size:14px;text-align:center;padding:24px 16px 40px}
a,button{transition:transform .12s ease,box-shadow .2s ease,background-color .2s ease}
:focus-visible{outline:2px solid #2DD4BF;outline-offset:2px}
html,body{overflow-x:clip}
header .brandlink{flex:none}header .brand{flex:none;overflow:visible}
.nx-langwrap{flex:none!important;margin-left:auto!important}.nx-langwrap select{width:128px}
@media(max-width:520px){.sumgrid{grid-template-columns:1fr 1fr 1fr}.sumbox .v{font-size:16px}}
</style>
</head>
<body>
<header>
  <a class="brandlink" href="https://nexus-2e23d.web.app/" target="_blank" rel="noopener" aria-label="넥서스 그룹 홈페이지"><svg class="logo" viewBox="0 0 100 100" fill="none" aria-label="Nexus Group Logo">
    <defs>
      <linearGradient id="nexusCyan" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#38BDF8"/><stop offset="100%" stop-color="#818CF8"/>
      </linearGradient>
      <linearGradient id="nexusViolet" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#818CF8"/><stop offset="100%" stop-color="#38BDF8" stop-opacity="0.2"/>
      </linearGradient>
    </defs>
    <g class="nxspin">
    <ellipse cx="50" cy="50" rx="38" ry="14" stroke="url(#nexusCyan)" stroke-width="2.5" transform="rotate(-30 50 50)" stroke-linecap="round"/>
    <ellipse cx="50" cy="50" rx="38" ry="14" stroke="url(#nexusViolet)" stroke-width="2.5" transform="rotate(30 50 50)" stroke-linecap="round"/>
    <ellipse cx="50" cy="50" rx="38" ry="14" stroke="#F8FAFC" stroke-width="1.5" stroke-opacity="0.75" transform="rotate(90 50 50)" stroke-dasharray="3 3"/>
    </g>
    <circle cx="50" cy="50" r="4.5" fill="#38BDF8"/><circle cx="50" cy="50" r="2" fill="#F8FAFC"/>
  </svg><span class="brand"><b>NEXUS GROUP</b><span>넥서스 가계부</span></span></a>
  <span class="testbadge">테스트 버전</span>
</header>
<main>

<h1>넥서스 가계부</h1>
<p class="sub">수입과 지출을 이 전화기에 기록하는 장부입니다.</p>
<p class="sub">회원가입 없음 · 이용료 없음 · 무제한 사용</p>
<div class="notice">이 도구는 기록을 쌓는 도구입니다. 금융 조언은 하지 않으며, 기록은 이 기기 안에만 저장됩니다.</div>

<section class="panel">
  <h2>이번 달 요약</h2>
  <div class="sumgrid">
    <div class="sumbox"><div class="k">수입</div><div class="v" id="sumIn">0원</div></div>
    <div class="sumbox"><div class="k">지출</div><div class="v" id="sumOut">0원</div></div>
    <div class="sumbox"><div class="k">남은 금액</div><div class="v" id="sumLeft">0원</div></div>
  </div>
</section>

<section class="panel">
  <h2>기록 추가</h2>
  <div class="seg" id="kindSeg">
    <button type="button" data-kind="out" class="on">지출</button>
    <button type="button" data-kind="in">수입</button>
  </div>
  <div class="fields">
    <div class="field"><label for="amtIn">금액 (원)</label><input type="number" id="amtIn" inputmode="decimal" min="0" step="1" placeholder="0"></div>
    <div class="field"><label for="catSel">분류</label><select id="catSel"></select></div>
    <div class="field"><label for="dateIn">날짜</label><input type="date" id="dateIn"></div>
    <div class="field"><label for="memoIn">메모 (선택)</label><input type="text" id="memoIn" maxlength="40" placeholder="짧은 메모"></div>
  </div>
  <button type="button" class="bigbtn" id="addBtn">기록 추가</button>
  <p class="msg" id="addMsg" role="status"></p>
</section>

<section class="panel">
  <h2>기록 목록</h2>
  <div class="fields">
    <div class="field"><label for="monthSel">보는 달</label><input type="month" id="monthSel"></div>
  </div>
  <ul class="list" id="recList"></ul>
  <p class="sub" id="emptyMsg">이 달의 기록이 없습니다.</p>
  <div class="rowbtns">
    <button type="button" class="ghostbtn" id="copyBtn">이 달 요약 복사</button>
    <button type="button" class="ghostbtn" id="wipeBtn">전체 삭제</button>
  </div>
  <p class="msg" id="listMsg" role="status"></p>
</section>

<script>
(function(){
"use strict";
var LS="nxbudget.records.v1";
var CATS_OUT=["식비","주거","교통","생활","건강","여가","교육","기타"];
var CATS_IN=["월급","용돈","기타 수입"];
var kind="out";
function $(id){return document.getElementById(id)}
function load(){try{var r=JSON.parse(localStorage.getItem(LS)||"[]");return Array.isArray(r)?r:[]}catch(e){return[]}}
function save(){try{localStorage.setItem(LS,JSON.stringify(records))}catch(e){}}
var records=load();
function fmt(n){return n.toLocaleString("ko-KR")+"원"}
function fillCats(){var s=$("catSel");s.innerHTML="";(kind==="out"?CATS_OUT:CATS_IN).forEach(function(c){var o=document.createElement("option");o.value=c;o.textContent=c;s.appendChild(o)})}
$("kindSeg").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;kind=b.dataset.kind;document.querySelectorAll("#kindSeg button").forEach(function(x){x.classList.toggle("on",x===b)});fillCats()});
function monthOf(dstr){return (dstr||"").slice(0,7)}
function render(){
  var m=$("monthSel").value||monthOf(new Date().toISOString());
  var list=records.filter(function(r){return monthOf(r.date)===m}).sort(function(a,b){return a.date<b.date?1:-1});
  var ti=0,to=0;list.forEach(function(r){if(r.kind==="in")ti+=r.amt;else to+=r.amt});
  $("sumIn").textContent=fmt(ti);$("sumOut").textContent=fmt(to);$("sumLeft").textContent=fmt(ti-to);
  var ul=$("recList");ul.innerHTML="";
  list.forEach(function(r){
    var li=document.createElement("li");
    var g=document.createElement("div");g.className="grow";
    var nm=document.createElement("div");nm.textContent=(r.kind==="in"?"수입 · ":"지출 · ")+r.cat+" — "+fmt(r.amt);
    var mt=document.createElement("div");mt.className="meta";mt.textContent=r.date+(r.memo?" · "+r.memo:"");
    g.appendChild(nm);g.appendChild(mt);
    var del=document.createElement("button");del.type="button";del.className="del";del.textContent="삭제";
    del.addEventListener("click",function(){records=records.filter(function(x){return x.id!==r.id});save();render();$("listMsg").textContent="기록 하나를 지웠습니다."});
    li.appendChild(g);li.appendChild(del);ul.appendChild(li);
  });
  $("emptyMsg").style.display=list.length?"none":"block";
}
$("addBtn").addEventListener("click",function(){
  var amt=parseFloat($("amtIn").value);
  if(!(amt>0)){$("addMsg").textContent="금액이 비어 있습니다.";return}
  var d=$("dateIn").value||new Date().toISOString().slice(0,10);
  records.push({id:Date.now()+"-"+Math.random().toString(36).slice(2,7),kind:kind,amt:amt,cat:$("catSel").value,date:d,memo:$("memoIn").value.trim()});
  save();$("amtIn").value="";$("memoIn").value="";$("monthSel").value=monthOf(d);render();
  $("addMsg").textContent="기록이 저장됐습니다.";
});
$("monthSel").addEventListener("change",render);
$("copyBtn").addEventListener("click",function(){
  var t="가계부 요약 ("+$("monthSel").value+")\n수입 "+$("sumIn").textContent+" · 지출 "+$("sumOut").textContent+" · 남은 금액 "+$("sumLeft").textContent;
  if(navigator.clipboard)navigator.clipboard.writeText(t).then(function(){$("listMsg").textContent="요약이 복사됐습니다."});
});
$("wipeBtn").addEventListener("click",function(){
  if(!confirm("정말로 모든 기록을 지울까요?"))return;
  records=[];save();render();$("listMsg").textContent="모든 기록을 지웠습니다.";
});
var now=new Date();
$("dateIn").value=now.toISOString().slice(0,10);
$("monthSel").value=now.toISOString().slice(0,7);
fillCats();render();
})();
</script>

</main>
<footer>우주의 모든 의식체는 친구이자 동반자이다<br><small>Every conscious being in the universe is a friend and companion</small><br>🌐 호스팅: Firebase · 🔒 모든 기록은 당신의 기기 안에서만 저장됩니다</footer>
