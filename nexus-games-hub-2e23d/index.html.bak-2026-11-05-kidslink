<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>넥서스 게임즈 — Nexus Games</title>
<meta name="description" content="유아부터 어른까지, 나이에 맞는 놀이를 한곳에 모은 게임 방 — 장보기 매치3, 오늘의 낱말 한 판, 기억 한 스푼">
<link rel="manifest" href="/manifest.json">
<link rel="icon" href="/icon-192.png">
<meta property="og:title" content="넥서스 게임즈">
<meta property="og:description" content="나이에 맞는 놀이를 한곳에 모은 게임 방입니다">
<meta property="og:image" content="/og.jpg">
<style>
  :root{--bg:#0B1226;--cyan:#38BDF8;--teal:#2DD4BF;--violet:#818CF8;--green:#4ADE80;--amber:#FBBF24;--ink:#F8FAFC;--muted:#A8B3C7;--card:rgba(255,255,255,.06);--line:rgba(255,255,255,.14)}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans KR",sans-serif;font-size:18px;line-height:1.6;-webkit-tap-highlight-color:transparent}
  @keyframes nxspin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
  .nxspin{transform-origin:50% 50%;animation:nxspin 26s linear infinite}
  @keyframes nxIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  header{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:12px;padding:10px 16px;background:rgba(11,15,25,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  header .logo{width:40px;height:40px;flex:none}
  header .brand{line-height:1.2;flex:1}
  header .brand b{font-size:15px;letter-spacing:.14em}
  header .brand span{display:block;font-size:11px;color:var(--muted);letter-spacing:.2em}
  .testbadge{flex:none;font-size:12px;font-weight:700;color:#FDE68A;border:1px solid rgba(253,230,138,.5);border-radius:999px;padding:5px 10px}
  header .homebtn{flex:none;font-size:14px;font-weight:700;color:#06121F;background:linear-gradient(135deg,var(--cyan),var(--violet));border-radius:999px;padding:10px 16px;text-decoration:none;white-space:nowrap}
  main{max-width:920px;margin:0 auto;padding:22px 16px 90px;animation:nxIn .5s ease both}
  h1{font-size:29px;margin:6px 0 4px}
  .sub{color:var(--muted);font-size:17px;margin:0 0 8px}
  .promise{margin:14px 0 4px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.35);border-radius:14px;padding:12px 16px;font-size:16px}
  .roomtitle{display:flex;align-items:center;gap:9px;margin:30px 0 12px;font-size:21px;font-weight:800}
  .roomdot{width:11px;height:11px;border-radius:50%;background:var(--room,#fff);box-shadow:0 0 12px var(--room,#fff)}
  .roomtitle .en{font-size:12px;color:var(--muted);letter-spacing:.18em;font-weight:600}
  .roomtitle .ages{margin-left:auto;font-size:14px;color:var(--muted);font-weight:600}
  .grid{display:grid;grid-template-columns:1fr;gap:12px}
  @media(min-width:640px){.grid{grid-template-columns:1fr 1fr}}
  a.gcard{display:flex;gap:14px;align-items:flex-start;text-decoration:none;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;transition:transform .15s ease,border-color .15s ease;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
  a.gcard:active{transform:scale(.985)}
  .gcard .gic{width:64px;height:64px;flex:none;border-radius:16px;background:rgba(255,255,255,.05);border:1px solid var(--line);display:flex;align-items:center;justify-content:center}
  .gcard h3{margin:2px 0 4px;font-size:20px}
  .gcard p{margin:0;color:var(--muted);font-size:16px}
  .gcard .go{margin-top:8px;display:inline-block;font-weight:700;color:var(--cyan);font-size:16px}
  .sooncard{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.03);border:1px dashed rgba(255,255,255,.25);border-radius:18px;padding:18px}
  .soonpill{flex:none;font-size:13px;font-weight:800;color:#0B1226;background:var(--amber);border-radius:999px;padding:4px 11px;margin-top:3px}
  .sooncard h3{margin:2px 0 4px;font-size:20px}
  .sooncard p{margin:0;color:var(--muted);font-size:16px}
  footer{max-width:920px;margin:0 auto;padding:0 16px 40px;color:var(--muted);font-size:14px}
  /* ---- 모듈 공통 ---- */
  .modbar{display:flex;align-items:center;gap:10px;margin-bottom:6px}
  .backlink{flex:none;text-decoration:none;color:#06121F;background:linear-gradient(135deg,var(--cyan),var(--violet));font-weight:800;border-radius:999px;padding:10px 16px;font-size:16px}
  .modtitle{font-size:26px;margin:8px 0 2px}
  .howto{color:var(--muted);font-size:17px;margin:0 0 14px}
  .senior{font-size:20px}
  .senior button{font-family:inherit}
  .bigbtn{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:14px;padding:14px 22px;font-size:20px;font-weight:700;cursor:pointer;min-height:60px}
  .bigbtn:active{transform:scale(.98)}
  .bigbtn.primary{background:linear-gradient(135deg,var(--cyan),var(--teal));color:#06121F;border:0}
  .bigbtn:disabled{opacity:.45;cursor:default}
  .msg{min-height:32px;font-size:19px;font-weight:700;margin:10px 0}
  .donebox{margin-top:18px;background:rgba(74,222,128,.09);border:1px solid rgba(74,222,128,.4);border-radius:18px;padding:22px;text-align:center;animation:nxIn .5s ease both}
  .donebox h3{font-size:25px;margin:4px 0 8px}
  .donebox p{font-size:18px;color:var(--ink);margin:6px 0}
  .donebox .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:14px}
  /* ---- 매치3 ---- */
  .m3wrap{display:flex;flex-direction:column;gap:14px}
  @media(min-width:760px){.m3wrap{flex-direction:row;align-items:flex-start}}
  .m3side{flex:1;min-width:230px}
  .goalbox{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px}
  .goalbox h4{margin:0 0 10px;font-size:19px}
  .goalrow{display:flex;align-items:center;gap:10px;font-size:19px;margin:7px 0}
  .goalrow .cnt{margin-left:auto;font-weight:800}
  .goalrow.done .cnt{color:var(--green)}
  .m3board{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;max-width:520px;width:100%;margin:0 auto;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:18px;padding:8px}
  .m3tile{position:relative;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:rgba(255,255,255,.06);aspect-ratio:1/1.08;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;cursor:pointer;padding:2px;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;transition:transform .15s ease,box-shadow .15s ease,opacity .18s ease}
  .m3tile svg{width:62%;height:auto;display:block}
  .m3tile .tn{font-size:11px;color:var(--ink);line-height:1.1;font-weight:700}
  @media(min-width:480px){.m3tile .tn{font-size:12.5px}}
  .m3tile.sel{box-shadow:0 0 0 3px var(--amber),0 0 18px rgba(251,191,36,.5);transform:scale(1.06);z-index:2}
  .m3tile.hint{box-shadow:0 0 0 3px var(--cyan),0 0 16px rgba(56,189,248,.55)}
  .m3tile.clearing{opacity:0;transform:scale(.4)}
  /* ---- 낱말 ---- */
  .wdate{font-size:17px;color:var(--amber);font-weight:800;letter-spacing:.02em}
  .wprog{font-size:17px;color:var(--muted);font-weight:700}
  .wclue{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;font-size:21px;margin:12px 0}
  .wchoseong{font-size:19px;color:var(--cyan);font-weight:800;margin-top:8px}
  .wslots{display:flex;gap:9px;justify-content:center;margin:18px 0 8px;flex-wrap:wrap}
  .wslot{width:62px;height:68px;border-radius:14px;border:2px dashed rgba(255,255,255,.35);background:rgba(255,255,255,.04);display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:800}
  .wslot.filled{border-style:solid;border-color:var(--teal);background:rgba(45,212,191,.12)}
  .wslot.locked{border-color:var(--amber);background:rgba(251,191,36,.13)}
  .wpool{display:flex;gap:9px;justify-content:center;flex-wrap:wrap;margin:12px 0}
  .wtile{width:58px;height:62px;border-radius:13px;border:1px solid var(--line);background:rgba(255,255,255,.09);font-size:26px;font-weight:800;color:var(--ink);cursor:pointer}
  .wtile:disabled{opacity:.22;cursor:default}
  .wrow{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:8px}
  /* ---- 기억 ---- */
  .memgrid{display:flex;gap:11px;flex-wrap:wrap;justify-content:center;margin:16px 0}
  .memtile{width:104px;min-height:104px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.06);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:8px;font-size:18px;font-weight:800;color:var(--ink)}
  .memtile svg{width:44px;height:auto}
  button.memtile{cursor:pointer;font-family:inherit}
  button.memtile.picked{box-shadow:0 0 0 3px var(--amber);background:rgba(251,191,36,.13)}
  button.memtile.right{box-shadow:0 0 0 3px var(--green);background:rgba(74,222,128,.14)}
  button.memtile.missed{box-shadow:0 0 0 3px var(--cyan);background:rgba(56,189,248,.10)}
  button.memtile.wrong{opacity:.45}
  .membar{height:12px;border-radius:99px;background:rgba(255,255,255,.1);overflow:hidden;max-width:520px;margin:10px auto}
  .membar i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--teal));width:100%}
  .memphase{font-size:21px;font-weight:800;text-align:center}
  .center{text-align:center}
</style>
<style id="nx-pagefix">html,body{overflow-x:clip}body>header{flex-wrap:wrap}header .brandlink{min-width:0}header .brand{min-width:0;overflow:hidden}header .brand b{white-space:nowrap}header .brand span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.nx-langwrap{flex:none!important}</style></head>
