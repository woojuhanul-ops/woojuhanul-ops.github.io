<script>
window.NXGAMES = window.NXGAMES || {};
(function(){
  var m = new URLSearchParams(location.search).get('m');
  var views = { hub:'view-hub', match3:'view-match3', word:'view-word', memory:'view-memory' };
  var key = views[m] ? m : 'hub';
  Object.keys(views).forEach(function(k){ document.getElementById(views[k]).hidden = (k !== key); });
  document.getElementById('foot-hub').hidden = (key !== 'hub');
  window.NXGAMES.module = key;
  if (key === 'match3') startMatch3();
  if (key === 'word') startWord();
  if (key === 'memory') startMemory();
  function wait(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }

  /* ================= 장보기 매치3 ================= */
  function startMatch3(){
    var TYPES = [
      { id:'apple',  name:'사과', svg:'<svg viewBox="0 0 48 48"><circle cx="24" cy="28" r="13" fill="#EF4444"/><path d="M24 16c1-4.4 5-6.2 8.4-5.8-.4 3.4-2.6 6-6 6.2" fill="#4ADE80"/><rect x="22.8" y="12" width="2.6" height="6" rx="1.3" fill="#92400E"/></svg>' },
      { id:'carrot', name:'당근', svg:'<svg viewBox="0 0 48 48"><path d="M14 14 L30 30 c2.4 2.4 1 6-2 6 L14 22 Z" fill="#F97316" transform="rotate(8 24 24)"/><path d="M13 15c-2.6-3.4-1.6-6.8 0-8.6 1.4 1.8 1.6 4.4.6 6.6M16.4 12.4C16 8.6 18 5.8 20 4.4c1 2.4.4 5-1.2 7" fill="none" stroke="#4ADE80" stroke-width="2.4" stroke-linecap="round"/></svg>' },
      { id:'milk',   name:'우유', svg:'<svg viewBox="0 0 48 48"><path d="M17 14 L24 7 l7 7 v24 a2 2 0 0 1 -2 2 H19 a2 2 0 0 1 -2 -2 Z" fill="#F8FAFC"/><path d="M17 14 h14 v7 H17 Z" fill="#38BDF8"/><rect x="20" y="25" width="8" height="8" rx="2" fill="#38BDF8" opacity=".55"/></svg>' },
      { id:'bread',  name:'빵',   svg:'<svg viewBox="0 0 48 48"><path d="M10 22c0-6 6-10 14-10s14 4 14 10c0 2.4-1.2 4-3 5v7a2 2 0 0 1 -2 2 H15 a2 2 0 0 1 -2 -2 v-7c-1.8-1-3-2.6-3-5Z" fill="#E8B04B"/><path d="M18 18.4c1.4 1.4 1.4 3 0 4.4M24 17.4c1.4 1.4 1.4 3 0 4.4M30 18.4c1.4 1.4 1.4 3 0 4.4" stroke="#B97F26" stroke-width="2" fill="none" stroke-linecap="round"/></svg>' },
      { id:'cheese', name:'치즈', svg:'<svg viewBox="0 0 48 48"><path d="M7 33 L41 15 v18 a2 2 0 0 1 -2 2 H9 a2 2 0 0 1 -2 -2Z" fill="#FBBF24"/><circle cx="18" cy="28" r="3" fill="#D97706" opacity=".65"/><circle cx="30" cy="27" r="2.2" fill="#D97706" opacity=".65"/><circle cx="25" cy="32" r="1.7" fill="#D97706" opacity=".65"/></svg>' },
      { id:'fish',   name:'생선', svg:'<svg viewBox="0 0 48 48"><path d="M6 24c6-8 13-11 20-11 6 0 10 4 13 11-3 7-7 11-13 11-7 0-14-3-20-11Z" fill="#38BDF8"/><path d="M39 24l6-6v12Z" fill="#0284C7"/><circle cx="15" cy="21.4" r="2" fill="#0B1226"/></svg>' }
    ];
    var N = 8, MAXMOVES = 40;
    var GOALS = [ {id:'apple', n:6}, {id:'milk', n:6}, {id:'bread', n:6} ];
    var grid = [], sel = null, busy = false, moves = 0, score = 0, got = {}, over = false;
    var boardEl = document.getElementById('m3-board');
    var msgEl = document.getElementById('m3-msg');
    function typeName(id){ for (var i=0;i<TYPES.length;i++) if (TYPES[i].id===id) return TYPES[i].name; return id; }
    function newTile(r,c){
      var bad = {};
      if (c>=2 && grid[r][c-1]===grid[r][c-2] && grid[r][c-1]>=0) bad[grid[r][c-1]]=1;
      if (r>=2 && grid[r-1][c]===grid[r-2][c] && grid[r-1][c]>=0) bad[grid[r-1][c]]=1;
      var t; do { t = (Math.random()*TYPES.length)|0; } while (bad[t]);
      return t;
    }
    function reset(){
      grid = []; sel = null; busy = false; moves = 0; score = 0; got = {}; over = false;
      GOALS.forEach(function(g){ got[g.id]=0; });
      for (var r=0;r<N;r++){ grid.push([]); for (var c=0;c<N;c++) grid[r].push(newTile(r,c)); }
      if (!findMove()) { reset(); return; }
      document.getElementById('m3-done').hidden = true;
      document.getElementById('m3-out').hidden = true;
      msgEl.textContent = '재료 두 개를 골라 자리를 바꿔 보세요.';
      render();
    }
    function render(){
      boardEl.innerHTML = '';
      for (var r=0;r<N;r++) for (var c=0;c<N;c++){
        (function(r,c){
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'm3tile';
          b.dataset.r = r; b.dataset.c = c;
          var t = TYPES[grid[r][c]];
          b.innerHTML = t.svg + '<span class="tn">' + t.name + '</span>';
          b.setAttribute('aria-label', t.name);
          if (sel && sel.r===r && sel.c===c) b.classList.add('sel');
          b.addEventListener('click', function(){ onTap(r,c); });
          boardEl.appendChild(b);
        })(r,c);
      }
      var g = document.getElementById('m3-goals'); g.innerHTML = '';
      GOALS.forEach(function(goal){
        var row = document.createElement('div');
        row.className = 'goalrow' + (got[goal.id] >= goal.n ? ' done' : '');
        row.innerHTML = '<span>' + typeName(goal.id) + '</span><span class="cnt">' + Math.min(got[goal.id], goal.n) + ' / ' + goal.n + (got[goal.id] >= goal.n ? ' ✓' : '') + '</span>';
        g.appendChild(row);
      });
      document.getElementById('m3-moves').textContent = moves;
      document.getElementById('m3-maxmoves').textContent = MAXMOVES;
      document.getElementById('m3-score').textContent = score;
    }
    function findMatches(){
      var hit = {};
      var r,c,k;
      for (r=0;r<N;r++){ c=0; while (c<N){ k=c+1; while (k<N && grid[r][k]===grid[r][c]) k++; if (grid[r][c]>=0 && k-c>=3) for (var i=c;i<k;i++) hit[r+','+i]=1; c=k; } }
      for (c=0;c<N;c++){ r=0; while (r<N){ k=r+1; while (k<N && grid[k][c]===grid[r][c]) k++; if (grid[r][c]>=0 && k-r>=3) for (var j=r;j<k;j++) hit[j+','+c]=1; r=k; } }
      return Object.keys(hit).map(function(s){ var p=s.split(','); return [ +p[0], +p[1] ]; });
    }
    function swap(a,b){ var t = grid[a[0]][a[1]]; grid[a[0]][a[1]] = grid[b[0]][b[1]]; grid[b[0]][b[1]] = t; }
    function findMove(){
      var dirs = [[0,1],[1,0]], best = null;
      for (var r=0;r<N;r++) for (var c=0;c<N;c++) for (var d=0;d<2;d++){
        var r2 = r+dirs[d][0], c2 = c+dirs[d][1];
        if (r2>=N || c2>=N) continue;
        swap([r,c],[r2,c2]);
        var m = findMatches();
        swap([r,c],[r2,c2]);
        if (m.length){
          var gain = 0;
          m.forEach(function(cell){ var id = TYPES[grid[cell[0]][cell[1]]].id; if (got[id] !== undefined && got[id] < (GOALS.filter(function(g){return g.id===id;})[0]||{}).n) gain++; });
          var cand = { a:[r,c], b:[r2,c2], gain:gain, n:m.length };
          if (!best || cand.gain > best.gain || (cand.gain===best.gain && cand.n > best.n)) best = cand;
        }
      }
      return best;
    }
    function goalDone(){ return GOALS.every(function(g){ return got[g.id] >= g.n; }); }
    async function resolveChain(){
      busy = true; var combo = 0;
      while (true){
        var m = findMatches();
        if (!m.length) break;
        combo++;
        m.forEach(function(cell){
          var id = TYPES[grid[cell[0]][cell[1]]].id;
          if (got[id] !== undefined) got[id]++;
          score += 10 * combo;
          var el = boardEl.children[cell[0]*N + cell[1]];
          if (el) el.classList.add('clearing');
        });
        renderSide();
        await wait(240);
        m.forEach(function(cell){ grid[cell[0]][cell[1]] = -1; });
        for (var c=0;c<N;c++){
          var stack = [];
          for (var r=N-1;r>=0;r--) if (grid[r][c] >= 0) stack.push(grid[r][c]);
          for (var r2=N-1;r2>=0;r2--) grid[r2][c] = stack.length ? stack.shift() : newTile(r2,c);
        }
        render();
        await wait(130);
      }
      busy = false;
      if (goalDone()){ over = true; finish(true); return; }
      if (moves >= MAXMOVES){ over = true; finish(false); return; }
      if (!findMove()){
        msgEl.textContent = '더 맞출 곳이 없어 판을 새로 섞었어요.';
        for (var r3=0;r3<N;r3++) for (var c3=0;c3<N;c3++) grid[r3][c3] = newTile(r3,c3);
        render();
      }
    }
    function renderSide(){
      var g = document.getElementById('m3-goals'); g.innerHTML = '';
      GOALS.forEach(function(goal){
        var row = document.createElement('div');
        row.className = 'goalrow' + (got[goal.id] >= goal.n ? ' done' : '');
        row.innerHTML = '<span>' + typeName(goal.id) + '</span><span class="cnt">' + Math.min(got[goal.id], goal.n) + ' / ' + goal.n + (got[goal.id] >= goal.n ? ' ✓' : '') + '</span>';
        g.appendChild(row);
      });
      document.getElementById('m3-score').textContent = score;
    }
    function finish(won){
      render();
      if (won){
        document.getElementById('m3-done-text').textContent = '움직인 횟수 ' + moves + '번, 점수 ' + score + '점. 장보기 목록을 모두 채웠습니다.';
        document.getElementById('m3-done').hidden = false;
        msgEl.textContent = '목록을 다 채웠어요!';
      } else {
        document.getElementById('m3-out').hidden = false;
        msgEl.textContent = '횟수를 다 썼어요.';
      }
    }
    async function onTap(r,c){
      if (busy || over) return;
      clearHints();
      if (!sel){ sel = {r:r,c:c}; render(); return; }
      if (sel.r===r && sel.c===c){ sel = null; render(); return; }
      var adj = Math.abs(sel.r-r) + Math.abs(sel.c-c) === 1;
      if (!adj){ sel = {r:r,c:c}; render(); return; }
      var a = [sel.r, sel.c], b = [r, c]; sel = null;
      swap(a,b); render();
      busy = true; await wait(160);
      if (!findMatches().length){
        swap(a,b); render();
        msgEl.textContent = '셋이 모이지 않았어요. 다른 짝을 골라 보세요.';
        busy = false; return;
      }
      moves++;
      document.getElementById('m3-moves').textContent = moves;
      msgEl.textContent = '담겼어요!';
      await resolveChain();
      if (!over) msgEl.textContent = '좋아요. 다음 짝을 골라 보세요.';
      render();
    }
    function clearHints(){ boardEl.querySelectorAll('.hint').forEach(function(el){ el.classList.remove('hint'); }); }
    document.getElementById('m3-hint').addEventListener('click', function(){
      if (busy || over) return;
      var mv = findMove(); if (!mv) return;
      clearHints();
      [mv.a, mv.b].forEach(function(cell){ var el = boardEl.children[cell[0]*N+cell[1]]; if (el) el.classList.add('hint'); });
      msgEl.textContent = '반짝이는 두 재료를 바꿔 보세요.';
    });
    document.getElementById('m3-restart').addEventListener('click', reset);
    document.getElementById('m3-again').addEventListener('click', reset);
    document.getElementById('m3-again2').addEventListener('click', reset);
    window.NXGAMES.match3 = {
      state: function(){ return { moves:moves, maxMoves:MAXMOVES, score:score, got:Object.assign({},got), goals:GOALS.map(function(g){return {id:g.id,n:g.n};}), busy:busy, over:over, won: over && goalDone() }; },
      findMove: findMove
    };
    reset();
  }

