      { w:'영수증', h:'물건을 사고 돈을 냈다는 증표 종이' },
      { w:'리모컨', h:'멀리서 텔레비전을 켜고 끄는 작은 기계' },
      { w:'선풍기', h:'여름에 바람을 일으켜 시원하게 해 주는 기계' },
      { w:'난로', h:'겨울 방을 데우는 기구' },
      { w:'이불', h:'잘 때 몸에 덮는 포근한 것' },
      { w:'베개', h:'잘 때 머리를 괴는 것' },
      { w:'거울', h:'얼굴을 비춰 보는 반짝이는 판' },
      { w:'빗', h:'머리를 곱게 넘길 때 쓰는 도구' },
      { w:'치약', h:'이를 닦을 때 칫솔에 짜서 쓰는 것' },
      { w:'수건', h:'씻고 나서 물기를 닦는 천' },
      { w:'우유', h:'아침에 한 잔 마시면 든든한 하얀 음료' },
      { w:'요구르트', h:'우유를 발효시킨 새콤한 음료' },
      { w:'고구마', h:'겨울에 쪄 먹으면 달콤한 뿌리 작물' },
      { w:'밤', h:'가을에 줍는, 껍질을 까서 먹는 열매. 군것으로도 좋습니다' },
      { w:'대추', h:'약식과 차에 넣는 붉은 열매' },
      { w:'인삼', h:'몸에 좋다고 알려진 뿌리 약재' },
      { w:'꿀', h:'벌이 모아 주는 달콤한 것' }
    ];
    var CHO = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
    function choOf(word){ return Array.prototype.map.call(word, function(ch){ var code = ch.charCodeAt(0) - 0xAC00; return code < 0 ? ch : CHO[Math.floor(code/588)]; }).join(' '); }
    function mulberry32(a){ return function(){ a |= 0; a = a + 0x6D2B79F5 | 0; var t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
    var now = new Date();
    var seed = now.getFullYear()*10000 + (now.getMonth()+1)*100 + now.getDate();
    var rng = mulberry32(seed);
    var order = WORDS.map(function(_,i){ return i; });
    for (var i=order.length-1;i>0;i--){ var j = Math.floor(rng()*(i+1)); var t=order[i]; order[i]=order[j]; order[j]=t; }
    var daily = order.slice(0,5).map(function(i){ return WORDS[i]; });
    var DAYS = ['일','월','화','수','목','금','토'];
    document.getElementById('w-date').textContent = now.getFullYear() + '년 ' + (now.getMonth()+1) + '월 ' + now.getDate() + '일 (' + DAYS[now.getDay()] + '요일)의 판';
    var idx = 0, slots = [], pool = [], solvedWords = [];
    var msgEl = document.getElementById('w-msg');
    function syllables(w){ return w.split(''); }
    function loadWord(){
      var item = daily[idx], ans = syllables(item.w);
      slots = ans.map(function(){ return { ch:'', locked:false, tile:-1 }; });
      var tiles = ans.map(function(s,k){ return { ch:s, ans:true, used:false }; });
      var extra = [];
      var guard = 0;
      while (extra.length < 4 && guard++ < 200){
        var src = WORDS[Math.floor(rng()*WORDS.length)].w;
        var s = src[Math.floor(rng()*src.length)];
        if (ans.indexOf(s) === -1 && extra.indexOf(s) === -1) extra.push(s);
      }
      extra.forEach(function(s){ tiles.push({ ch:s, ans:false, used:false }); });
      for (var k=tiles.length-1;k>0;k--){ var j2 = Math.floor(rng()*(k+1)); var t2=tiles[k]; tiles[k]=tiles[j2]; tiles[j2]=t2; }
      pool = tiles;
      document.getElementById('w-prog').textContent = (idx+1) + '번째 낱말 / 모두 ' + daily.length + '개';
      document.getElementById('w-clue').textContent = '뜻: ' + item.h;
      document.getElementById('w-cho').textContent = '초성 힌트: ' + choOf(item.w);
      msgEl.textContent = '';
      renderWord();
    }
    function renderWord(){
      var sl = document.getElementById('w-slots'); sl.innerHTML = '';
      slots.forEach(function(s,i){
        var d = document.createElement('button');
        d.type = 'button'; d.className = 'wslot' + (s.ch ? ' filled' : '') + (s.locked ? ' locked' : '');
        d.textContent = s.ch || '';
        d.setAttribute('aria-label', s.ch ? s.ch : '빈 칸');
        d.addEventListener('click', function(){
          if (s.locked || !s.ch) return;
          pool[s.tile].used = false; s.ch = ''; s.tile = -1; renderWord();
        });
        sl.appendChild(d);
      });
      var pl = document.getElementById('w-pool'); pl.innerHTML = '';
      pool.forEach(function(t2,i){
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'wtile'; b.textContent = t2.ch; b.disabled = t2.used;
        b.addEventListener('click', function(){
          var empty = slots.findIndex(function(s){ return !s.ch; });
          if (empty === -1) { msgEl.textContent = '칸이 다 찼어요. 칸을 누르면 글자가 돌아갑니다.'; return; }
          slots[empty].ch = t2.ch; slots[empty].tile = i; t2.used = true; renderWord();
        });
        pl.appendChild(b);
      });
    }
    document.getElementById('w-check').addEventListener('click', function(){
      var item = daily[idx], ans = item.w;
      if (slots.some(function(s){ return !s.ch; })){ msgEl.textContent = '아직 빈 칸이 있어요.'; return; }
      var made = slots.map(function(s){ return s.ch; }).join('');
      if (made === ans){
        solvedWords.push(ans);
        idx++;
        if (idx >= daily.length){
          document.getElementById('w-done-text').textContent = '오늘의 낱말: ' + solvedWords.join(' · ') + '. 내일이면 또 새 판이 열립니다.';
          document.getElementById('w-done').hidden = false;
          msgEl.textContent = '한 판을 다 채웠어요!';
          try { localStorage.setItem('nxgames_word_done', String(seed)); } catch(e){}
        } else {
          msgEl.textContent = '맞았어요! 다음 낱말입니다.';
          loadWord();
        }
      } else {
        msgEl.textContent = '조금 아쉬워요. 뜻과 초성을 다시 보고 바꿔 보세요.';
      }
    });
    document.getElementById('w-hint').addEventListener('click', function(){
      var ans = syllables(daily[idx].w);
      slots.forEach(function(s){ if (!s.locked && s.ch){ pool[s.tile].used = false; s.ch=''; s.tile=-1; } });
      var i = 0;
      slots[0].locked = true; slots[0].ch = ans[0];
      for (var k=0;k<pool.length;k++){ if (!pool[k].used && pool[k].ch === ans[0]){ pool[k].used = true; slots[0].tile = k; break; } }
      msgEl.textContent = '첫 글자를 알려 드렸어요: ' + ans[0];
      renderWord();
    });
    document.getElementById('w-again').addEventListener('click', function(){
      idx = 0; solvedWords = [];
      document.getElementById('w-done').hidden = true;
      loadWord();
    });
    window.NXGAMES.word = {
      state: function(){ return { seed: seed, index: idx, total: daily.length, answer: daily[Math.min(idx, daily.length-1)].w, done: idx >= daily.length, daily: daily.map(function(d){ return d.w; }) }; }
    };
    loadWord();
  }

  /* ================= 기억 한 스푼 ================= */
  function startMemory(){
    var GLYPH = {
      apple:'<svg viewBox="0 0 48 48"><circle cx="24" cy="28" r="13" fill="#EF4444"/><path d="M24 16c1-4.4 5-6.2 8.4-5.8-.4 3.4-2.6 6-6 6.2" fill="#4ADE80"/></svg>',
      milk:'<svg viewBox="0 0 48 48"><path d="M17 14 L24 7 l7 7 v24 a2 2 0 0 1 -2 2 H19 a2 2 0 0 1 -2 -2 Z" fill="#F8FAFC"/><path d="M17 14 h14 v7 H17 Z" fill="#38BDF8"/></svg>',
      bread:'<svg viewBox="0 0 48 48"><path d="M10 22c0-6 6-10 14-10s14 4 14 10c0 2.4-1.2 4-3 5v7a2 2 0 0 1 -2 2 H15 a2 2 0 0 1 -2 -2 v-7c-1.8-1-3-2.6-3-5Z" fill="#E8B04B"/></svg>',
      egg:'<svg viewBox="0 0 48 48"><ellipse cx="24" cy="27" rx="11" ry="14" fill="#FDE68A"/><circle cx="24" cy="29" r="5.4" fill="#F59E0B"/></svg>',
      grape:'<svg viewBox="0 0 48 48"><circle cx="18" cy="22" r="5.6" fill="#A78BFA"/><circle cx="30" cy="22" r="5.6" fill="#8B5CF6"/><circle cx="24" cy="31" r="5.6" fill="#A78BFA"/><circle cx="14" cy="31" r="5" fill="#8B5CF6"/><circle cx="34" cy="31" r="5" fill="#7C3AED"/><path d="M24 15c.6-3.6 3-5.4 5.6-5.6-.2 3-1.8 5.2-4.4 5.6" fill="#4ADE80"/></svg>',
      onion:'<svg viewBox="0 0 48 48"><path d="M24 10c7 5 11 10 11 16a11 11 0 1 1 -22 0c0-6 4-11 11-16Z" fill="#E9D5FF"/><path d="M24 14v24M18.5 17.5C16 21 14.8 24 14.6 27M29.5 17.5C32 21 33.2 24 33.4 27" stroke="#C084FC" stroke-width="1.7" fill="none"/></svg>',
      potato:'<svg viewBox="0 0 48 48"><ellipse cx="24" cy="25" rx="14" ry="11" fill="#C89B62"/><circle cx="19" cy="21" r="1.7" fill="#A97B43"/><circle cx="28" cy="27" r="1.7" fill="#A97B43"/><circle cx="24" cy="31" r="1.4" fill="#A97B43"/></svg>',
      tofu:'<svg viewBox="0 0 48 48"><rect x="11" y="13" width="26" height="22" rx="4" fill="#F8FAFC"/><rect x="11" y="13" width="26" height="22" rx="4" fill="none" stroke="#CBD5E1" stroke-width="2"/></svg>',
      mushroom:'<svg viewBox="0 0 48 48"><path d="M8 23a16 10 0 0 1 32 0Z" fill="#F87171"/><circle cx="18" cy="18" r="2.2" fill="#FEE2E2"/><circle cx="29" cy="16" r="1.8" fill="#FEE2E2"/><path d="M20 23h8l1.4 11a3 3 0 0 1 -3 3.4h-4.8a3 3 0 0 1 -3 -3.4Z" fill="#FDE68A"/></svg>',
      carrot:'<svg viewBox="0 0 48 48"><path d="M15 15 L31 31c2.4 2.4 1 6-2 6 L15 23 Z" fill="#F97316"/><path d="M14 16c-2.6-3.4-1.6-6.8 0-8.6 1.4 1.8 1.6 4.4.6 6.6" fill="none" stroke="#4ADE80" stroke-width="2.4" stroke-linecap="round"/></svg>',
      cheese:'<svg viewBox="0 0 48 48"><path d="M7 33 L41 15 v18 a2 2 0 0 1 -2 2 H9 a2 2 0 0 1 -2 -2Z" fill="#FBBF24"/><circle cx="18" cy="28" r="3" fill="#D97706" opacity=".65"/><circle cx="30" cy="27" r="2.2" fill="#D97706" opacity=".65"/></svg>',
      fish:'<svg viewBox="0 0 48 48"><path d="M6 24c6-8 13-11 20-11 6 0 10 4 13 11-3 7-7 11-13 11-7 0-14-3-20-11Z" fill="#38BDF8"/><path d="M39 24l6-6v12Z" fill="#0284C7"/><circle cx="15" cy="21.4" r="2" fill="#0B1226"/></svg>'
    };
    var ITEMS = [
      { id:'apple', name:'사과' }, { id:'milk', name:'우유' }, { id:'bread', name:'빵' }, { id:'egg', name:'달걀' },
      { id:'grape', name:'포도' }, { id:'onion', name:'양파' }, { id:'potato', name:'감자' }, { id:'tofu', name:'두부' },
      { id:'mushroom', name:'버섯' }, { id:'carrot', name:'당근' }, { id:'cheese', name:'치즈' }, { id:'fish', name:'생선' }
    ];
    var ROUNDS = [ { n:4, sec:5 }, { n:5, sec:6 }, { n:6, sec:7 } ];
    var round = 0, phase = 'idle', answers = [], choices = [], picked = {}, totalHit = 0, totalN = 0, timer = null, reshowUsed = false, checked = false;
    var gridEl = document.getElementById('mem-grid'), phaseEl = document.getElementById('mem-phase'), msgEl = document.getElementById('mem-msg');
    var mainBtn = document.getElementById('mem-main'), reshowBtn = document.getElementById('mem-reshow'), barWrap = document.getElementById('mem-barwrap'), barEl = document.getElementById('mem-bar');
    function shuffle(a){ for (var i=a.length-1;i>0;i--){ var j = Math.floor(Math.random()*(i+1)); var t=a[i]; a[i]=a[j]; a[j]=t; } return a; }
    function tile(item, btn){
      var d = document.createElement(btn ? 'button' : 'div');
      if (btn) d.type = 'button';
      d.className = 'memtile'; d.dataset.id = item.id;
      d.innerHTML = GLYPH[item.id] + '<span>' + item.name + '</span>';
      return d;
    }
    function startRound(){
      var cfg = ROUNDS[round];
      answers = shuffle(ITEMS.slice()).slice(0, cfg.n);
      picked = {}; checked = false; reshowUsed = false;
      document.getElementById('mem-done').hidden = true;
      showPhase(cfg.sec);
    }
    function showPhase(sec){
      phase = 'show';
      phaseEl.textContent = (round+1) + '번째 숟가락 — 물건 ' + answers.length + '개를 보여 드립니다';
      msgEl.textContent = '천천히 눈에 담아 두세요.';
      gridEl.innerHTML = '';
      answers.forEach(function(it){ gridEl.appendChild(tile(it, false)); });
      mainBtn.hidden = true; reshowBtn.hidden = true;
      barWrap.hidden = false;
      barEl.style.transition = 'none'; barEl.style.width = '100%';
      requestAnimationFrame(function(){ requestAnimationFrame(function(){
        barEl.style.transition = 'width ' + sec + 's linear'; barEl.style.width = '0%';
      }); });
      clearTimeout(timer);
      timer = setTimeout(recallPhase, sec*1000);
    }
    function recallPhase(){
      clearTimeout(timer);
      phase = 'recall';
      picked = {};
      var need = answers.length;
      var others = shuffle(ITEMS.filter(function(it){ return answers.indexOf(it) === -1; })).slice(0, 9 - need);
      choices = shuffle(answers.concat(others));
      phaseEl.textContent = '아까 본 물건 ' + need + '개를 골라 보세요';
      msgEl.textContent = '';
      gridEl.innerHTML = '';
      choices.forEach(function(it){
        var b = tile(it, true);
        b.addEventListener('click', function(){
          if (checked) return;
          if (picked[it.id]) { delete picked[it.id]; b.classList.remove('picked'); }
          else {
            if (Object.keys(picked).length >= need){ msgEl.textContent = need + '개까지 고를 수 있어요. 하나를 빼고 골라 보세요.'; return; }
            picked[it.id] = 1; b.classList.add('picked');
          }
        });
        gridEl.appendChild(b);
      });
      barWrap.hidden = true;
      mainBtn.hidden = false; mainBtn.textContent = '다 골랐어요 — 확인';
      reshowBtn.hidden = reshowUsed;
    }
    function checkRound(){
      checked = true;
      var hit = 0;
      gridEl.querySelectorAll('.memtile').forEach(function(el){
        var id = el.dataset.id;
        var was = answers.some(function(a){ return a.id === id; });
        var isPicked = !!picked[id];
        if (was && isPicked){ el.classList.add('right'); hit++; }
        else if (was && !isPicked){ el.classList.add('missed'); }
        else if (!was && isPicked){ el.classList.add('wrong'); }
        el.disabled = true;
      });
      totalHit += hit; totalN += answers.length;
      msgEl.textContent = answers.length + '개 중 ' + hit + '개를 맞혔어요.' + (hit === answers.length ? ' 다 기억하셨네요!' : ' 초록 테두리는 맞힌 것, 파란 테두리는 놓친 것입니다.');
      reshowBtn.hidden = true;
      if (round < ROUNDS.length - 1){ mainBtn.textContent = '다음 숟가락으로'; }
      else { mainBtn.textContent = '결과 보기'; }
      phase = 'feedback';
    }
    mainBtn.addEventListener('click', function(){
      if (phase === 'idle'){ round = 0; totalHit = 0; totalN = 0; startRound(); }
      else if (phase === 'recall'){
        if (Object.keys(picked).length === 0){ msgEl.textContent = '하나라도 골라 보세요.'; return; }
        checkRound();
      }
      else if (phase === 'feedback'){
        if (round < ROUNDS.length - 1){ round++; startRound(); }
        else {
          phase = 'done';
          mainBtn.hidden = true;
          document.getElementById('mem-done-text').textContent = '모두 ' + totalN + '개 가운데 ' + totalHit + '개를 맞혔습니다. 오늘 머리를 쓰는 즐거운 한 판이었어요.';
          document.getElementById('mem-done').hidden = false;
          phaseEl.textContent = '세 숟가락을 모두 마쳤습니다';
        }
      }
    });
    reshowBtn.addEventListener('click', function(){
      if (phase !== 'recall' || reshowUsed) return;
      reshowUsed = true; reshowBtn.hidden = true;
      showPhase(3);
      msgEl.textContent = '한 번 더 보여 드립니다. 이번에는 짧게요.';
    });
    document.getElementById('mem-again').addEventListener('click', function(){
      round = 0; totalHit = 0; totalN = 0; phase = 'idle';
      document.getElementById('mem-done').hidden = true;
      startRound();
    });
    phaseEl.textContent = '시작하기를 누르면 물건이 잠깐 나타납니다';
    window.NXGAMES.memory = {
      state: function(){ return { round: round, phase: phase, answers: answers.map(function(a){ return a.id; }), picked: Object.keys(picked), totalHit: totalHit, totalN: totalN, done: phase === 'done' }; }
    };
  }
})();
</script>
