      <span class="gic"><svg width="40" height="40" viewBox="0 0 48 48"><circle cx="17" cy="19" r="7.5" fill="#EF4444"/><path d="M17 12c1-3.4 4-4.6 6.4-4.4-.4 2.6-2 4.6-4.8 4.8" fill="#4ADE80"/><rect x="27" y="12" width="9" height="13" rx="2" fill="#F8FAFC"/><rect x="27" y="12" width="9" height="4.6" fill="#38BDF8"/><circle cx="17" cy="34" r="6.4" fill="#FBBF24"/><circle cx="30" cy="34" r="6.4" fill="#A78BFA"/></svg></span>
