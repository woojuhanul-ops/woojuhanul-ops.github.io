  .card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--acc) 60%,transparent);box-shadow:0 12px 40px -12px color-mix(in srgb,var(--acc) 55%,transparent),inset 0 1px 0 rgba(255,255,255,.12);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
  .card .kicker{font-size:11px;letter-spacing:.28em;font-weight:700;color:var(--acc)}
  .card h2{font-size:19px;margin:6px 0 4px}
  .card h2 small{display:block;font-size:13px;color:var(--muted);font-weight:400;letter-spacing:.04em;margin-top:2px}
