    linear-gradient(to left,var(--acc) 16px,transparent 16px) 100% 0,
    linear-gradient(to bottom,var(--acc) 16px,transparent 16px) 100% 0,
    linear-gradient(to right,var(--acc) 16px,transparent 16px) 0 100%,
    linear-gradient(to top,var(--acc) 16px,transparent 16px) 0 100%,
    linear-gradient(to left,var(--acc) 16px,transparent 16px) 100% 100%,
    linear-gradient(to top,var(--acc) 16px,transparent 16px) 100% 100%;
    background-repeat:no-repeat;background-size:16px 2px,2px 16px,16px 2px,2px 16px,16px 2px,2px 16px,16px 2px,2px 16px;opacity:.85;pointer-events:none}
