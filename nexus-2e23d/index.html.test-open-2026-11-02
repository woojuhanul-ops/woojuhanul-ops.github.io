<style>
  :root{--bg:#0E1528;--ink:#F8FAFC;--muted:#A7B4C8;--line:rgba(255,255,255,.14);--cyan:#38BDF8;--violet:#818CF8;--magenta:#F472B6;--green:#4ADE80;--amber:#FBBF24;--teal:#2DD4BF}
