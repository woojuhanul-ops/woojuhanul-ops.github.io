<script>
/* NX-TAP-FIX2 (2026-11-02): instant tap feedback + warm navigation */
document.addEventListener('touchstart',function(){},{passive:true});
(function(){
  var warmed={};
  function warm(u){
    if(!u||warmed[u])return; warmed[u]=1;
    try{var l=document.createElement('link');l.rel='prefetch';l.href=u;l.as='document';document.head.appendChild(l);}catch(e){}
    try{fetch(u,{mode:'no-cors',credentials:'omit'}).catch(function(){});}catch(e){}
  }
  function cardOf(e){var t=e&&e.target;return (t&&t.closest)?t.closest('a.card, .toollist a'):null;}
  document.addEventListener('pointerdown',function(e){var a=cardOf(e);if(a){a.classList.add('pressed');warm(a.href);}},{passive:true});
  document.addEventListener('touchstart',function(e){var a=cardOf(e);if(a){a.classList.add('pressed');warm(a.href);}},{passive:true});
  function clear(){var p=document.querySelectorAll('.pressed');for(var i=0;i<p.length;i++)p[i].classList.remove('pressed');}
  document.addEventListener('pointerup',clear,{passive:true});
  document.addEventListener('pointercancel',clear,{passive:true});
  window.addEventListener('pagehide',clear);
})();
