  .aurora{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
  .aurora i{position:absolute;width:55vw;height:55vw;border-radius:50%;filter:blur(90px);opacity:.6}
  .aurora i:nth-child(1){background:radial-gradient(circle,#0EA5E9,transparent 65%);top:-18%;left:-12%;animation:drift1 26s ease-in-out infinite alternate}
  .aurora i:nth-child(2){background:radial-gradient(circle,#8B5CF6,transparent 65%);top:8%;right:-18%;animation:drift2 32s ease-in-out infinite alternate}
  .aurora i:nth-child(3){background:radial-gradient(circle,#EC4899,transparent 65%);bottom:-25%;left:28%;animation:drift1 38s ease-in-out infinite alternate-reverse}
  .aurora i:nth-child(4){background:radial-gradient(circle,#14B8A6,transparent 65%);bottom:5%;right:22%;opacity:.3;animation:drift2 30s ease-in-out infinite alternate-reverse}
  @keyframes drift1{from{transform:translate(0,0) scale(1)}to{transform:translate(6vw,4vh) scale(1.15)}}
  @keyframes drift2{from{transform:translate(0,0) scale(1.1)}to{transform:translate(-5vw,-3vh) scale(.95)}}
